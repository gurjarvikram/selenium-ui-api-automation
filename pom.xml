<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.vikram</groupId>
    <artifactId>selenium-ui-api-automation</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>selenium-ui-api-automation</name>
    <description>Hybrid UI and API automation framework built on Selenium 4, REST Assured and TestNG</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>21</maven.compiler.release>

        <!-- Overridden by the profiles below; regression is the default suite. -->
        <suite.file>testSuites/regression.xml</suite.file>

        <selenium.version>4.48.0</selenium.version>
        <restassured.version>6.0.1</restassured.version>
        <testng.version>7.12.0</testng.version>
        <jackson.version>2.22.3</jackson.version>
        <assertj.version>3.27.7</assertj.version>
        <extentreports.version>5.1.2</extentreports.version>
        <slf4j.version>2.0.18</slf4j.version>
        <surefire.version>3.5.6</surefire.version>
        <compiler.version>3.15.0</compiler.version>
        <checkstyle.plugin.version>3.6.0</checkstyle.plugin.version>
        <enforcer.version>3.6.3</enforcer.version>
    </properties>

    <profiles>
        <!-- API only: no browser needed, so CI can run this as a fast gate. -->
        <profile>
            <id>api</id>
            <properties>
                <suite.file>testSuites/api.xml</suite.file>
            </properties>
        </profile>

        <!-- Browser-only journeys. -->
        <profile>
            <id>ui</id>
            <properties>
                <suite.file>testSuites/ui.xml</suite.file>
            </properties>
        </profile>

        <!-- Cross-layer tests: API setup with UI assertions and the reverse. -->
        <profile>
            <id>hybrid</id>
            <properties>
                <suite.file>testSuites/hybrid.xml</suite.file>
            </properties>
        </profile>

        <!-- Fast confidence check across all three layers. -->
        <profile>
            <id>smoke</id>
            <properties>
                <suite.file>testSuites/smoke.xml</suite.file>
            </properties>
        </profile>

        <!-- Everything, browser journeys serialized against the shared cart. -->
        <profile>
            <id>regression</id>
            <properties>
                <suite.file>testSuites/regression.xml</suite.file>
            </properties>
        </profile>
    </profiles>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${compiler.version}</version>
            </plugin>

            <!-- Quality gate: fails the build before a single test runs. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-checkstyle-plugin</artifactId>
                <version>${checkstyle.plugin.version}</version>
                <configuration>
                    <configLocation>config/checkstyle.xml</configLocation>
                    <includeTestSourceDirectory>true</includeTestSourceDirectory>
                    <violationSeverity>error</violationSeverity>
                    <failOnViolation>true</failOnViolation>
                </configuration>
                <executions>
                    <execution>
                        <id>validate</id>
                        <phase>validate</phase>
                        <goals><goal>check</goal></goals>
                    </execution>
                </executions>
            </plugin>

            <!-- Guards against split dependency versions creeping back in. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>${enforcer.version}</version>
                <!-- Plugin level, not execution level, so `mvn enforcer:enforce`
                     from the command line sees the same rules the build does. -->
                <configuration>
                    <rules>
                        <requireMavenVersion><version>[3.8,)</version></requireMavenVersion>
                        <requireJavaVersion><version>[21,)</version></requireJavaVersion>
                        <banDuplicatePomDependencyVersions/>
                    </rules>
                </configuration>
                <executions>
                    <execution>
                        <id>enforce</id>
                        <goals><goal>enforce</goal></goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${surefire.version}</version>
                <configuration>
                    <suiteXmlFiles>
                        <suiteXmlFile>${suite.file}</suiteXmlFile>
                    </suiteXmlFiles>
                    <!-- A suite with no matching tests is a misconfiguration, not a pass. -->
                    <failIfNoSpecifiedTests>true</failIfNoSpecifiedTests>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <dependencies>
        <!-- Browser automation. Selenium Manager resolves drivers, so no WebDriverManager. -->
        <dependency>
            <groupId>org.seleniumhq.selenium</groupId>
            <artifactId>selenium-java</artifactId>
            <version>${selenium.version}</version>
        </dependency>

        <!-- API layer. -->
        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>rest-assured</artifactId>
            <version>${restassured.version}</version>
        </dependency>
        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>json-path</artifactId>
            <version>${restassured.version}</version>
        </dependency>

        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson.version}</version>
        </dependency>

        <dependency>
            <groupId>org.testng</groupId>
            <artifactId>testng</artifactId>
            <version>${testng.version}</version>
        </dependency>

        <!-- Fluent assertions: failure messages name the subject and the expectation. -->
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>${assertj.version}</version>
        </dependency>

        <dependency>
            <groupId>com.aventstack</groupId>
            <artifactId>extentreports</artifactId>
            <version>${extentreports.version}</version>
        </dependency>

        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <version>${slf4j.version}</version>
        </dependency>
    </dependencies>
</project>
