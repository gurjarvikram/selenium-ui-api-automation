<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- One representative test per layer: the gate CI runs on every push. -->
<suite name="Smoke Suite" parallel="tests" thread-count="2">
	<listeners>
		<listener class-name="com.vikram.listeners.Listeners" />
		<listener class-name="com.vikram.listeners.RetryTransformer" />
	</listeners>

	<test name="API smoke" parallel="classes" thread-count="2">
		<groups>
			<run><include name="smoke" /></run>
		</groups>
		<packages>
			<package name="com.vikram.tests.api" />
		</packages>
	</test>

	<!-- Sequential: shared cart, see regression.xml. -->
	<test name="Browser smoke">
		<groups>
			<run><include name="smoke" /></run>
		</groups>
		<packages>
			<package name="com.vikram.tests.ui" />
			<package name="com.vikram.tests.hybrid" />
		</packages>
	</test>
</suite>
