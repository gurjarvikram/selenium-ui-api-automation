<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Regression Suite" parallel="classes" thread-count="3">
	<listeners>
		<listener class-name="com.vikram.listeners.Listeners" />
		<listener class-name="com.vikram.listeners.RetryTransformer" />
	</listeners>
	<test name="Full regression">
		<groups>
			<run>
				<include name="regression" />
				<include name="negative" />
				<include name="api" />
				<include name="hybrid" />
			</run>
		</groups>
		<packages>
			<package name="com.vikram.tests.ui" />
			<package name="com.vikram.tests.api" />
			<package name="com.vikram.tests.hybrid" />
		</packages>
	</test>
</suite>
