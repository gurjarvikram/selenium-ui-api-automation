# Copy to .env, fill in a real account, and export before running:
#   set -a && source .env && set +a
#
# Credentials never live in config.properties or in test data, so nothing secret is
# committed. CI supplies the same two values as repository secrets.

ECOM_USER_EMAIL=your-account@example.com
ECOM_USER_PASSWORD=your-password

# Optional. Every key in config.properties and env-{name}.properties can be overridden
# from the environment by upper-casing it and turning dots into underscores, so these two
# point the suites at a different deployment without touching a file. Left unset, they
# fall back to env-demo.properties, which is where the committed defaults belong -- a URL
# is configuration, not a secret. In CI they come from repository *variables*, not
# secrets, for the same reason.
#
# UI_BASE_URL=https://rahulshettyacademy.com/client/
# API_BASE_URL=https://rahulshettyacademy.com
